package "Custom Data Structures" {
    
    class TransactionQueue {
        - List<Transaction> queue
        - int maxSize
        - int front
        - int rear
        __
        + TransactionQueue()
        + TransactionQueue(maxSize: int)
        __
        + enqueue(transaction: Transaction): boolean
        + dequeue(): Transaction
        + peek(): Transaction
        + isEmpty(): boolean
        + size(): int
        + isFull(): boolean
        + clear(): void
        + getAllTransactions(): List<Transaction>
        + search(transactionId: String): int
        + getAt(position: int): Transaction
        + toString(): String
    }
    
    class TransactionStack {
        - List<Transaction> stack
        - int maxSize
        __
        + TransactionStack()
        + TransactionStack(maxSize: int)
        __
        + push(transaction: Transaction): boolean
        + pop(): Transaction
        + peek(): Transaction
        + isEmpty(): boolean
        + size(): int
        + isFull(): boolean
        + clear(): void
        + getAllTransactions(): List<Transaction>
        + search(transactionId: String): int
        + toString(): String
    }
    
    class TransactionHistory {
        - List<Transaction> undoStack
        - List<Transaction> redoStack
        - int maxSize
        __
        + TransactionHistory()
        __
        + pushToUndoStack(transaction: Transaction): void
        + popFromUndoStack(): Transaction
        + popFromRedoStack(): Transaction
        + peekUndoStack(): Transaction
        + peekRedoStack(): Transaction
        + canUndo(): boolean
        + canRedo(): boolean
        + getUndoStackSize(): int
        + getRedoStackSize(): int
        + getUndoableTransactions(): List<Transaction>
        + getRedoableTransactions(): List<Transaction>
        + clear(): void
        + clearRedoStack(): void
        + toString(): String
    }
}

' ============= REPOSITORY LAYER =============

package "Repository Layer" {
    
    interface CustomerRepository {
        + findByEmail(email: String): Optional<Customer>
        + findByEmailAndPassword(email: String, password: String): Optional<Customer>
        + findActiveCustomers(): List<Customer>
        + findByNameContainingIgnoreCase(name: String): List<Customer>
        + existsByEmail(email: String): boolean
        + findCustomersCreatedAfter(date: LocalDateTime): List<Customer>
        + countActiveCustomers(): long
    }
    
    interface AccountRepository {
        + findByAccountNumber(accountNumber: String): Optional<Account>
        + findByCustomerId(customerId: String): List<Account>
        + findActiveAccountsByCustomerId(customerId: String): List<Account>
        + findByAccountType(accountType: String): List<Account>
        + findByCustomerIdAndAccountType(customerId: String, accountType: String): List<Account>
        + findActiveAccountsByCustomerIdAndAccountType(customerId: String, accountType: String): List<Account>
        + findAccountsWithBalanceGreaterThan(amount: double): List<Account>
        + findAccountsWithBalanceLessThan(amount: double): List<Account>
        + existsByAccountNumber(accountNumber: String): boolean
        + countByCustomerId(customerId: String): long
        + findAllActiveAccounts(): List<Account>
        + findAccountsForTotalBalance(customerId: String): List<Account>
    }
    
    interface TransactionRepository {
        + findByTransactionId(transactionId: String): Optional<Transaction>
        + findByFromAccountNumber(accountNumber: String, sort: Sort): List<Transaction>
        + findByToAccountNumber(accountNumber: String, sort: Sort): List<Transaction>
        + findByAccountNumber(accountNumber: String, sort: Sort): List<Transaction>
        + findByTransactionType(transactionType: String, sort: Sort): List<Transaction>
        + findByStatus(status: String, sort: Sort): List<Transaction>
        + findByTransactionDateBetween(startDate: LocalDateTime, endDate: LocalDateTime, sort: Sort): List<Transaction>
        + findByAccountNumberAndDateRange(accountNumber: String, startDate: LocalDateTime, endDate: LocalDateTime, sort: Sort): List<Transaction>
        + findSuccessfulTransactions(sort: Sort): List<Transaction>
        + findFailedTransactions(sort: Sort): List<Transaction>
        + findPendingTransactions(): List<Transaction>
        + countByStatus(status: String): long
        + findByAmountBetween(minAmount: double, maxAmount: double, sort: Sort): List<Transaction>
        + findRecentTransactionsByAccountNumber(accountNumber: String, sort: Sort): List<Transaction>
        + findSuccessfulTransactionsForSettlement(startDate: LocalDateTime, endDate: LocalDateTime): List<Transaction>
        + findSuccessfulTransactionsByAccountNumberAndDateRange(accountNumber: String, startDate: LocalDateTime, endDate: LocalDateTime): List<Transaction>
        + findSuccessfulDebitTransactionsByAccountNumberAndDateRange(accountNumber: String, startDate: LocalDateTime, endDate: LocalDateTime): List<Transaction>
    }
    
    interface AuditLogRepository {
        + findByUserId(userId: String, sort: Sort): List<AuditLog>
        + findByAction(action: String, sort: Sort): List<AuditLog>
        + findByEntityType(entityType: String, sort: Sort): List<AuditLog>
        + findByEntityId(entityId: String, sort: Sort): List<AuditLog>
        + findByTimestampBetween(startDate: LocalDateTime, endDate: LocalDateTime, sort: Sort): List<AuditLog>
        + findByUserIdAndAction(userId: String, action: String, sort: Sort): List<AuditLog>
        + findByUserIdAndTimestampBetween(userId: String, startDate: LocalDateTime, endDate: LocalDateTime, sort: Sort): List<AuditLog>
        + findByIpAddress(ipAddress: String, sort: Sort): List<AuditLog>
        + findRecentLogs(since: LocalDateTime, sort: Sort): List<AuditLog>
        + countByAction(action: String): long
        + countByUserId(userId: String): long
        + findSecurityLogs(sort: Sort): List<AuditLog>
        + findTransactionLogs(sort: Sort): List<AuditLog>
        + findComplianceLogs(actions: List<String>, startDate: LocalDateTime, endDate: LocalDateTime, sort: Sort): List<AuditLog>
    }
}

