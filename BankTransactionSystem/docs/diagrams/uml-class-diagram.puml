    class AuditLogController {
        - AuditLogService auditLogService
        __
        + getAuditLogsByUser(userId: String): ResponseEntity<List<AuditLog>>
        + getTransactionLogsByUser(userId: String): ResponseEntity<List<AuditLog>>
        + getSecurityLogsByUser(userId: String): ResponseEntity<List<AuditLog>>
        + getRecentLogsByUser(userId: String, hours: int): ResponseEntity<List<AuditLog>>
        + getAuditLogsByAction(action: String): ResponseEntity<List<AuditLog>>
    }
    
    class SettlementController {
        - SettlementService settlementService
        __
        + performDailySettlement(): ResponseEntity<?>
        + performMonthlySettlement(): ResponseEntity<?>
        + reconcilePendingTransactions(): ResponseEntity<?>
        + getSettlementTransactions(startDate: String, endDate: String): ResponseEntity<?>
