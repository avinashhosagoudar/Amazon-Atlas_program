package "Controller Layer" {
    
    class CustomerController {
        - CustomerService customerService
        __
        + registerCustomer(request: Map): ResponseEntity<?>
        + loginCustomer(request: Map): ResponseEntity<?>
        + changePassword(request: Map): ResponseEntity<?>
    }
    
    class AccountController {
        - AccountService accountService
        __
        + createAccount(request: Map): ResponseEntity<?>
        + getAccountsByCustomer(customerId: String): ResponseEntity<List<Account>>
        + getAccountByNumber(accountNumber: String): ResponseEntity<?>
        + closeAccount(request: Map): ResponseEntity<?>
        + getTotalBalance(customerId: String): ResponseEntity<?>
    }
    
    class TransactionController {
        - TransactionService transactionService
        __
        + depositMoney(request: Map): ResponseEntity<?>
        + withdrawMoney(request: Map): ResponseEntity<?>
        + transferMoney(request: Map): ResponseEntity<?>
        + getTransactionHistory(accountNumber: String): ResponseEntity<List<Transaction>>
        + getTransactionStatistics(startDate: String, endDate: String): ResponseEntity<?>
        + getRecentTransactions(): ResponseEntity<List<Transaction>>
        + getPendingTransactions(): ResponseEntity<List<Transaction>>
        + processPendingTransactions(): ResponseEntity<?>
        + getTransactionLimits(accountType: String): ResponseEntity<?>
    }
    
    class TransactionHistoryController {
        - TransactionService transactionService
        __
        + undoLastTransaction(): ResponseEntity<?>
