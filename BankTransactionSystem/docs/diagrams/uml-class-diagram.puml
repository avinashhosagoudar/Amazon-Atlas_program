        + redoLastTransaction(): ResponseEntity<?>
        + redoLastTransactionForAccount(accountNumber: String): ResponseEntity<?>
        + canUndo(): ResponseEntity<?>
        + canRedo(): ResponseEntity<?>
        + getUndoableTransactions(): ResponseEntity<List<Transaction>>
        + getUndoableTransactionsForAccount(accountNumber: String): ResponseEntity<List<Transaction>>
        + getRedoableTransactions(): ResponseEntity<List<Transaction>>
        + getRedoableTransactionsForAccount(accountNumber: String): ResponseEntity<List<Transaction>>
        + getTransactionHistorySummary(): ResponseEntity<?>
