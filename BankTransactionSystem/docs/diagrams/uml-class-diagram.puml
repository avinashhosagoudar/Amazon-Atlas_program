' ============= RELATIONSHIPS =============

' Model relationships
Customer "1" -- "0..*" Account : has
Account "1" -- "0..*" Transaction : involved in
Customer "1" -- "0..*" AuditLog : tracked by

' Service layer dependencies
CustomerService --> CustomerRepository
CustomerService --> AuditLogService
AccountService --> AccountRepository
AccountService --> CustomerService
AccountService --> AuditLogService
AccountService --> TransactionService
TransactionService --> TransactionRepository
TransactionService --> AccountService
TransactionService --> CustomerService
TransactionService --> AuditLogService
TransactionService --> TransactionQueue
TransactionService --> TransactionStack
TransactionService --> TransactionHistory
AuditLogService --> AuditLogRepository
SettlementService --> TransactionRepository
SettlementService --> AuditLogService

' Controller layer dependencies
CustomerController --> CustomerService
AccountController --> AccountService
TransactionController --> TransactionService
TransactionHistoryController --> TransactionService
AuditLogController --> AuditLogService
SettlementController --> SettlementService

' Data structures
TransactionQueue o-- Transaction
TransactionStack o-- Transaction
TransactionHistory o-- Transaction

' Inner classes
TransactionService +-- TransactionStatistics
TransactionService +-- TransactionHistorySummary
SettlementService +-- SettlementResult
AuditLogService +-- AuditStatistics

' Repository inheritance
CustomerRepository --|> MongoRepository
AccountRepository --|> MongoRepository
TransactionRepository --|> MongoRepository
AuditLogRepository --|> MongoRepository

note right of TransactionService
  Core business logic for:
  - Money transfers
  - Transaction validation
  - Undo/Redo operations
  - Daily/monthly limits
  - ACID compliance
end note

note right of TransactionHistory
  Implements Command Pattern
  for Undo/Redo functionality
  using dual stack approach
end note

note right of AuditLogService
  Comprehensive audit trail
  for compliance and security
  monitoring
end note

